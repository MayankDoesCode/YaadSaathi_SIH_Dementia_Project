# YaadSaathi Environment Configuration Template
# Duplicate this file as .env.local and populate with your Gemini API key.

# Google Gemini Server-side API Key (Keep secret! Never prefix with VITE_)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Provider Configuration for Frontend
VITE_SAATHI_AI_PROVIDER=google-gemini
VITE_SAATHI_AI_ENDPOINT=/api/saathi/chat
VITE_SAATHI_AI_MODEL=gemini-3.5-flash-lite
